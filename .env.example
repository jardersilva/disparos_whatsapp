# URL da Evolution API e API key GLOBAL (AUTHENTICATION_API_KEY do servidor Evolution).
# Sem prefixo VITE_ de propósito: ficam só no servidor (proxy do Vite em dev, nginx em produção).
EVOLUTION_API_URL=https://sua-api.com
EVOLUTION_API_KEY=sua-api-key-global-aqui

# Instância selecionada por padrão (opcional; dá para trocar pela interface)
VITE_EVOLUTION_INSTANCE_NAME=nome-da-instancia
